POSTGRES_DB=meetpoint
POSTGRES_USER=meetpoint
# Set a unique random hexadecimal value before running Compose.
POSTGRES_PASSWORD=

# Replace both example origins with the release's HTTPS origins.
CLIENT_ORIGIN=https://meet.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.meet.example.com

# Oracle: set NEXT_PUBLIC_API_BASE_URL=/ and generate a separate 64-character hex secret.
API_PROXY_SHARED_SECRET=

CLIENT_BIND_PORT=10081
SERVER_BIND_PORT=13001
# Set to the directly connected proxy's exact IP after verifying it.
TRUSTED_PROXY_IPS=
# Set a unique tag for each release.
RELEASE_TAG=
